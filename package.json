{
  "name": "asya-pos",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun --filter=@asya-pos/web dev & bun --filter=@asya-pos/api dev",
    "dev:web": "bun --filter=@asya-pos/web dev",
    "dev:api": "bun --filter=@asya-pos/api dev",
    "build": "bun --filter=@asya-pos/web build",
    "build:api": "bun --filter=@asya-pos/api build",
    "preview": "bun --filter=@asya-pos/web preview",
    "db:generate": "bun --filter=@asya-pos/db run drizzle:generate",
    "db:push": "bun --filter=@asya-pos/db run drizzle:push",
    "db:migrate": "bun --filter=@asya-pos/db run drizzle:migrate",
    "db:studio": "bun --filter=@asya-pos/db run drizzle:studio",
    "db:seed": "bun --filter=@asya-pos/db seed"
  },
  "dependencies": {
    "dotenv": "^18.0.6"
  }
}
