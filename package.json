{
  "name": "asya-pos",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bun --filter=./apps/web dev & bun --filter=./apps/api dev",
    "dev:web": "bun --filter=./apps/web dev",
    "dev:api": "bun --filter=./apps/api dev",
    "build": "bun --filter=./apps/web build",
    "build:api": "bun --filter=./apps/api build",
    "preview": "bun --filter=./apps/web preview",
    "db:generate": "bun --filter=./packages/db drizzle-kit generate:mysql",
    "db:push": "bun --filter=./packages/db drizzle-kit push:mysql",
    "db:migrate": "bun --filter=./packages/db drizzle-kit migrate",
    "db:studio": "bun --filter=./packages/db drizzle-kit studio",
    "db:seed": "bun --filter=./packages/db seed"
  }
}
