# Database (SQLite)
# Contoh: "./data/asya.db" atau ":memory:" untuk testing
DATABASE_URL="./data/asya.db"

# Root project (opsional; dipakai saat bundle build agar path DB tetap benar)
ASYA_POS_ROOT="./"

# JWT Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Environment
NODE_ENV="development"

# API
API_PORT=3000
API_BASE_URL="http://localhost:3000"

# Web
WEB_URL="http://localhost:4321"
