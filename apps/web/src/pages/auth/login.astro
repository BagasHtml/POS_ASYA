---
import Layout from '@/layouts/Layout.astro';
import { Button } from '@/components/ui/Button.tsx';
---

<Layout title="Login - Asya POS">
  <main class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold">Masuk ke Asya POS</h1>
        <p class="mt-2 text-sm text-gray-600">Kelola penjualan dengan mudah</p>
      </div>
      <form class="space-y-4" action="/api/auth/login" method="post">
        <div class="space-y-2">
          <label for="email" class="text-sm font-medium">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
            placeholder="nama@contoh.com"
          />
        </div>
        <div class="space-y-2">
          <label for="password" class="text-sm font-medium">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
            placeholder="••••••••"
          />
        </div>
        <Button type="submit" className="w-full">Masuk</Button>
      </form>
      <p class="text-center text-sm text-gray-600">
        Belum punya akun? <a href="/auth/register" class="text-blue-600 hover:underline">Daftar</a>
      </p>
    </div>
  </main>
</Layout>
