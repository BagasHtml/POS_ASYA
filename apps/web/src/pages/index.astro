---
import Layout from '@/layouts/Layout.astro';
import { Button } from '@/components/ui/Button.tsx';
---

<Layout title="Asya POS - POS Sederhana & Terpercaya">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 py-12 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight">
      Asya POS
    </h1>
    <p class="mt-4 text-lg text-gray-600 max-w-xl">
      POS sederhana untuk operasional sehari-hari
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a href="/auth/login">
        <Button size="lg">Masuk</Button>
      </a>
      <a href="/auth/register">
        <Button variant="secondary" size="lg">Daftar</Button>
      </a>
    </div>
  </main>
</Layout>
